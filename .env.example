# BytePay origin for the public catalogue (/api/v1/catalog) behind plans and prices. No token needed.
BYTEPAY_HOST="https://core.nodebyte.host"

# nodebytestat.us public status API, shown in the footer. No auth needed.
STATUS_API_URL="https://nodebytestat.us"

# Optional. Raises GitHub's rate limit for the changelog page.
GITHUB_TOKEN=""
